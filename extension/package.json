{
  "name": "github2gitee-extension",
  "version": "0.4.3",
  "private": true,
  "description": "Browser extension to sync GitHub repositories to Gitee",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode chrome",
    "build": "node scripts/build.mjs chrome firefox",
    "build:all": "node scripts/build.mjs chrome edge firefox",
    "build:chrome": "vite build --mode chrome",
    "build:edge": "vite build --mode edge",
    "build:firefox": "vite build --mode firefox",
    "pack": "node scripts/pack.mjs",
    "pack:nobuild": "node scripts/pack.mjs --no-build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/webextension-polyfill": "^0.12.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
